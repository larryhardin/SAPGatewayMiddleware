{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug SapGateway",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/SapGateway/bin/Debug/net10.0/SapGateway.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/SapGateway",
      "stopAtEntry": false,
      "console": "internalConsole",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5291"
      }
    }
  ]
}
