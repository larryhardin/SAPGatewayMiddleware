{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Sap": {
    "TimeoutSeconds": 30,  
    "Destinations": [
      {
        "Name": "devecc",
        "Description": "Real SAP system via enosix Link (credentials from .env or user-secrets)",
        "BaseUrl": "${SAP_BASEURL}",
        "UserName": "${SAP_USER}",
        "Password": "${SAP_PASSWORD}"
      }
    ]
  }
}