{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Sap": {
    "TimeoutSeconds": 30,
    // Named SAP destinations, addressable via /sap/{Name}/**.
    // "self" is the built-in mock SAP system for local development.
    // Credentials support env-var placeholders: "${SAP_PASSWORD}" — never commit real secrets.
    "Destinations": [
      {
        "Name": "devecc",
        "Description": "Built-in mock SAP system (no real backend)",
        "BaseUrl": "${SAP_BASEURL}",
        "UserName": "${SAP_USER}",
        "Password": "${SAP_PASSWORD}"
      }
      // Example real destination:
      // {
      //   "Name": "EQ5",
      //   "Description": "ECC quality system",
      //   "BaseUrl": "https://sap-eq5.example.com:44300/sap/opu/odata/sap",
      //   "UserName": "${SAP_EQ5_USER}", ( if stored in dotnet secrets, for example)
      //   "Password": "${SAP_EQ5_PASSWORD}", ( if stored in dotnet secrets, for example)SS
      //   "DefaultHeaders": { "x-sap-client": "100" }
      // }
    ]
  }
}
