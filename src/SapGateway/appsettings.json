{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Sap": {
    // "self" = built-in mock SAP endpoints (/mock-sap/**) for local development.
    // For a real system: "https://sap-host:44300/sap/opu/odata/sap"
    "BaseUrl": "self",
    "TimeoutSeconds": 30,
    "DefaultHeaders": {
      "x-sap-client": "100"
    }
  }
}
